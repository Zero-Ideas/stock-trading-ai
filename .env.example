# Environment Variables for Stock Trading AI
# Copy this file to .env and update with your actual API keys

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-key-here

# Gemini API Key (get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-key-here

# Alpaca API Keys (get from: https://alpaca.markets/docs/api-documentation/api-v2/)
ALPACA_API_KEY_ID=your-alpaca-key-id-here
ALPACA_SECRET_KEY=your-alpaca-secret-key-here

# NewsAPI Key (get from: https://newsapi.org/)
NEWSAPI_KEY=your-newsapi-key-here